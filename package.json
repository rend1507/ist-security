{
  "name": "ist-security",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "env:sync": "bash scripts/sync-env-from-settings.sh",
    "db:migrate:local": "wrangler d1 migrations apply ist-security --local",
    "db:migrate:remote": "wrangler d1 migrations apply ist-security --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "bcryptjs": "^3.0.3",
    "jsqr": "^1.4.0",
    "next": "^15.5.9",
    "qrcode": "^1.5.4",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "wrangler": "^4.151.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
